# Copy this file to .env and fill in the values.

# Long random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional comma-separated list of Google emails allowed to sign in.
# Leave empty to allow any Google account.
ALLOWED_EMAILS=

# Shows a "Continue as local dev user" button on the sign-in page so the app
# can be tried before Google OAuth is set up. Never enable this in production.
DEV_LOGIN=true

# Set to true when served over HTTPS.
SESSION_COOKIE_SECURE=false

# Trust X-Forwarded-* headers from an HTTPS proxy. Defaults to true on PythonAnywhere.
# BEHIND_PROXY=false

# Threads used to fetch market data in parallel. Defaults to 1 on PythonAnywhere,
# whose web apps can't start threads, and 8 elsewhere.
# MAX_THREADS=8
